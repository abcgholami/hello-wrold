# =============================================================================
# VisionForge Platform — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://visionforge:visionforge_secret@localhost:5432/visionforge
DATABASE_URL_SYNC=postgresql://visionforge:visionforge_secret@localhost:5432/visionforge

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Object Storage (MinIO) ────────────────────────────────────────────────────
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=visionforge
MINIO_SECRET_KEY=visionforge_secret
MINIO_BUCKET=visionforge-media

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong random key for production: openssl rand -hex 32
JWT_SECRET=super-secret-jwt-key-change-in-production-immediately
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# ── AWS / MinIO credentials for MLflow ───────────────────────────────────────
AWS_ACCESS_KEY_ID=visionforge
AWS_SECRET_ACCESS_KEY=visionforge_secret

# ── AI Models ─────────────────────────────────────────────────────────────────
SAM2_MODEL=sam2_hiera_large
CLIP_MODEL=openai/clip-vit-base-patch32

# ── Training ──────────────────────────────────────────────────────────────────
TRAINING_TEMP_DIR=/tmp/visionforge

# ── Frontend URLs ─────────────────────────────────────────────────────────────
VITE_CORE_API_URL=http://localhost:8000
VITE_TRAIN_API_URL=http://localhost:8001
VITE_INFER_API_URL=http://localhost:8002
VITE_AI_ASSIST_URL=http://localhost:8003
