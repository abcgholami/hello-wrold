# GPU-enabled inference service
FROM nvcr.io/nvidia/tensorrt:24.03-py3

WORKDIR /app

RUN apt-get update && apt-get install -y \
    libpq-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    fastapi[all] \
    uvicorn[standard] \
    sqlalchemy[asyncio] \
    asyncpg \
    pydantic-settings \
    minio \
    redis \
    onnxruntime-gpu \
    opencv-python-headless \
    Pillow \
    numpy \
    prometheus-fastapi-instrumentator

COPY . .

EXPOSE 8002

CMD ["uvicorn", "infer_api.main:app", "--host", "0.0.0.0", "--port", "8002", "--workers", "2"]
